{"text": "Mesajlarıma bakar mısın?", "category": "temel_ihtiyac"}
{"text": "Sayfayı çevirir misin?", "category": "temel_ihtiyac"}
{"text": "Bulmaca çözmek istiyorum.", "category": "temel_ihtiyac"}
{"text": "Kalemimi verir misin?", "category": "temel_ihtiyac"}
{"text": "Bir şey yazmak istiyorum.", "category": "temel_ihtiyac"}
{"text": "Fotoğraf albümünü getirir misin?", "category": "temel_ihtiyac"}
{"text": "Eski fotoğraflara bakalım.", "category": "temel_ihtiyac"}
{"text": "Satranç oynayalım mı?", "category": "temel_ihtiyac"}
{"text": "Kart oynamak istiyorum.", "category": "temel_ihtiyac"}
{"text": "Yeni bir kitap almak istiyorum.", "category": "temel_ihtiyac"}
{"text": "Kitabın kaldığım yerini bulur musun?", "category": "temel_ihtiyac"}
{"text": "Yazılar çok küçük.", "category": "temel_ihtiyac"}
{"text": "Mendil verir misin?", "category": "temel_ihtiyac"}
{"text": "Bunu masaya koyar mısın?", "category": "temel_ihtiyac"}
{"text": "Bunu benden uzaklaştır.", "category": "temel_ihtiyac"}
{"text": "Çantamı getirir misin?", "category": "temel_ihtiyac"}
{"text": "Saatimi takar mısın?", "category": "temel_ihtiyac"}
{"text": "Yüzüğümü takar mısın?", "category": "temel_ihtiyac"}
{"text": "Tespihimi verir misin?", "category": "temel_ihtiyac"}
{"text": "Eşyalarımı ulaşabileceğim yere koy.", "category": "temel_ihtiyac"}
{"text": "Çağrı zilini yanıma koyar mısın?", "category": "temel_ihtiyac"}
{"text": "Zil elimin altında olsun.", "category": "temel_ihtiyac"}
{"text": "Terliklerimi getirir misin?", "category": "temel_ihtiyac"}
{"text": "Hırkamı yanıma koy.", "category": "temel_ihtiyac"}
{"text": "Şuradaki şeyi verir misin?", "category": "temel_ihtiyac"}
{"text": "Onu biraz sağa koyar mısın?", "category": "temel_ihtiyac"}
{"text": "Bunu yere düşürdüm.", "category": "temel_ihtiyac"}
{"text": "Bunu kaldırır mısın?", "category": "temel_ihtiyac"}
{"text": "Cihazın şarjı azaldı.", "category": "temel_ihtiyac"}
{"text": "Anahtarlarım nerede?", "category": "temel_ihtiyac"}
{"text": "Namaz kılmak istiyorum.", "category": "temel_ihtiyac"}
{"text": "Abdest almama yardım eder misin?", "category": "temel_ihtiyac"}
{"text": "Kuran dinlemek istiyorum.", "category": "temel_ihtiyac"}
{"text": "Ezan okundu mu?", "category": "temel_ihtiyac"}
{"text": "Seccademi serer misin?", "category": "temel_ihtiyac"}
{"text": "Oruç tutmak istiyorum.", "category": "temel_ihtiyac"}
{"text": "Bugün ne yapacağımızı planlayalım.", "category": "temel_ihtiyac"}
{"text": "Önce kahvaltı, sonra banyo.", "category": "temel_ihtiyac"}
{"text": "Biraz sonra hatırlat.", "category": "temel_ihtiyac"}
{"text": "Şimdi değil, sonra.", "category": "temel_ihtiyac"}
{"text": "Acelem yok.", "category": "temel_ihtiyac"}
{"text": "Biraz bekleyebilir misin?", "category": "temel_ihtiyac"}
{"text": "Bana biraz zaman ver.", "category": "temel_ihtiyac"}
{"text": "Hemen gelir misin?", "category": "temel_ihtiyac"}
{"text": "Buraya gelir misin?", "category": "temel_ihtiyac"}
{"text": "Yardıma ihtiyacım var.", "category": "temel_ihtiyac"}
{"text": "Bir şeye ihtiyacım var.", "category": "temel_ihtiyac"}
{"text": "Bir şey istiyorum ama söyleyemiyorum.", "category": "temel_ihtiyac"}
{"text": "Ne istediğimi tahmin edebilir misin?", "category": "temel_ihtiyac"}
{"text": "Bir şey daha istiyorum.", "category": "temel_ihtiyac"}
{"text": "Hepsi bu, teşekkürler.", "category": "temel_ihtiyac"}
{"text": "Çay saati geldi.", "category": "temel_ihtiyac"}
{"text": "Çayı biraz soğut, sonra ver.", "category": "temel_ihtiyac"}
{"text": "Bir bardak daha çay alabilir miyim?", "category": "temel_ihtiyac"}
{"text": "Kola içmek istiyorum.", "category": "temel_ihtiyac"}
{"text": "Sütü ısıtır mısın?", "category": "temel_ihtiyac"}
{"text": "Su içerken başımı tutar mısın?", "category": "temel_ihtiyac"}
{"text": "Suyu kaşıkla verir misin?", "category": "temel_ihtiyac"}
{"text": "Gazoz var mı?", "category": "temel_ihtiyac"}
{"text": "İçeceğime buz koyma.", "category": "temel_ihtiyac"}
{"text": "Şerbet yapar mısın?", "category": "temel_ihtiyac"}
{"text": "Bugün çorba var mı?", "category": "temel_ihtiyac"}
{"text": "Sıcak bir çorba iyi gelir.", "category": "temel_ihtiyac"}
{"text": "Ekmek istemiyorum.", "category": "temel_ihtiyac"}
{"text": "Ekmeği çorbaya batırır mısın?", "category": "temel_ihtiyac"}
{"text": "Simit alır mısın?", "category": "temel_ihtiyac"}
{"text": "Poğaça istiyorum.", "category": "temel_ihtiyac"}
{"text": "Menemen yapar mısın?", "category": "temel_ihtiyac"}
{"text": "Kahvaltı hazır mı?", "category": "temel_ihtiyac"}
{"text": "Kahvaltıyı yatakta yapalım.", "category": "temel_ihtiyac"}
{"text": "Masada yemek istiyorum.", "category": "temel_ihtiyac"}
{"text": "Hep birlikte yiyelim.", "category": "temel_ihtiyac"}
{"text": "Fırında tavuk yapar mısın?", "category": "temel_ihtiyac"}
{"text": "Kuru fasulye yemek istiyorum.", "category": "temel_ihtiyac"}
{"text": "Sarma yaptın mı?", "category": "temel_ihtiyac"}
{"text": "Canım mantı çekti.", "category": "temel_ihtiyac"}
{"text": "Turşu var mı?", "category": "temel_ihtiyac"}
{"text": "Salata yapar mısın?", "category": "temel_ihtiyac"}
{"text": "Salatayı ince doğrar mısın?", "category": "temel_ihtiyac"}
{"text": "Meyveleri küçük keser misin?", "category": "temel_ihtiyac"}
{"text": "Çekirdeksiz üzüm istiyorum.", "category": "temel_ihtiyac"}
{"text": "Kirazları yıkar mısın?", "category": "temel_ihtiyac"}
{"text": "Kek yaptın mı?", "category": "temel_ihtiyac"}
{"text": "Sütlaç istiyorum.", "category": "temel_ihtiyac"}
{"text": "Tadı biraz garip.", "category": "temel_ihtiyac"}
{"text": "Bu bozulmuş olabilir.", "category": "temel_ihtiyac"}
{"text": "Acı biber koyma.", "category": "temel_ihtiyac"}
{"text": "Baharat koyma, bana dokunuyor.", "category": "temel_ihtiyac"}
{"text": "Midem kaldırmıyor, hafif bir şey olsun.", "category": "temel_ihtiyac"}
{"text": "Biraz yiyip bırakacağım.", "category": "temel_ihtiyac"}
{"text": "Tuvalet sandalyesini getirir misin?", "category": "temel_ihtiyac"}
{"text": "Kapıyı çalmadan girmeyin.", "category": "temel_ihtiyac"}
{"text": "Ayaklarımı yıkar mısın?", "category": "temel_ihtiyac"}
{"text": "Ayaklarıma krem sürer misin?", "category": "temel_ihtiyac"}
{"text": "Sabunun kokusu çok ağır.", "category": "temel_ihtiyac"}
{"text": "Islak havluyla siler misin?", "category": "temel_ihtiyac"}
{"text": "Sırtımı siler misin?", "category": "temel_ihtiyac"}
{"text": "Saçımı kestirmek istiyorum.", "category": "temel_ihtiyac", "group": "sac_kesmek"}
{"text": "Saçımı kısa kestirmek istiyorum.", "category": "temel_ihtiyac", "group": "sac_kesmek"}
{"text": "Berberi eve çağırır mısın?", "category": "temel_ihtiyac"}
{"text": "Kaşlarımı alır mısın?", "category": "temel_ihtiyac"}
{"text": "Bıyığımı düzeltir misin?", "category": "temel_ihtiyac"}
{"text": "Tıraş bıçağı körelmiş.", "category": "temel_ihtiyac"}
{"text": "Tıraş makinesini getirir misin?", "category": "temel_ihtiyac"}
{"text": "Uyumadan önce biraz kitap okuyalım.", "category": "temel_ihtiyac"}
{"text": "Bu akşam geç yatacağım.", "category": "temel_ihtiyac"}
{"text": "Kediyi yanıma getirir misin?", "category": "temel_ihtiyac"}
{"text": "Kedimi sevmek istiyorum.", "category": "temel_ihtiyac"}
{"text": "Kuşun kafesini örter misin?", "category": "temel_ihtiyac"}
{"text": "Saksıları içeri alır mısın?", "category": "temel_ihtiyac"}
{"text": "Ortalığı süpürür müsün?", "category": "temel_ihtiyac"}
{"text": "Oda çok dağınık.", "category": "temel_ihtiyac"}
{"text": "Masayı temizler misin?", "category": "temel_ihtiyac"}
{"text": "Çöpü boşaltır mısın?", "category": "temel_ihtiyac"}
{"text": "Hava çok nemli.", "category": "temel_ihtiyac"}
{"text": "Odaya biraz oda spreyi sıkar mısın?", "category": "temel_ihtiyac"}
{"text": "Saati göreceğim bir yere asar mısın?", "category": "temel_ihtiyac"}
{"text": "Takvimi göreceğim yere koy.", "category": "temel_ihtiyac"}
{"text": "Bir film önerir misin?", "category": "temel_ihtiyac"}
{"text": "Bu filmi daha önce izledik.", "category": "temel_ihtiyac"}
{"text": "Sesi kapat, sadece görüntü kalsın.", "category": "temel_ihtiyac"}
{"text": "Kumandanın pili bitti.", "category": "temel_ihtiyac"}
{"text": "Ekrana bakmaktan gözlerim yoruldu.", "category": "temel_ihtiyac"}
{"text": "Biraz ara verelim.", "category": "temel_ihtiyac"}
{"text": "Bilgisayarı açar mısın?", "category": "temel_ihtiyac"}
{"text": "Bilgisayarda oyun oynamak istiyorum.", "category": "temel_ihtiyac"}
{"text": "Sesli kitap açar mısın?", "category": "temel_ihtiyac"}
{"text": "Gazetedeki bulmacayı bana okur musun?", "category": "temel_ihtiyac"}
{"text": "Markete gidecek misin?", "category": "temel_ihtiyac"}
{"text": "Gelirken bana da bir şey al.", "category": "temel_ihtiyac"}
{"text": "Alışveriş listesine süt ekle.", "category": "temel_ihtiyac"}
{"text": "Ekmek almayı unutma.", "category": "temel_ihtiyac"}
{"text": "Bana yeni bir pijama alır mısın?", "category": "temel_ihtiyac"}
{"text": "Yeni çorap almamız lazım.", "category": "temel_ihtiyac"}
{"text": "Cüzdanımı getirir misin?", "category": "temel_ihtiyac"}
{"text": "Kimliğimi çantama koyar mısın?", "category": "temel_ihtiyac"}
