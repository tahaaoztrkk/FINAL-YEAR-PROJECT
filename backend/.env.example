# Uygulama
APP_NAME="Goz Takibiyle Turkce Iletisim"
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Bakis kaynagi: mouse | webcam
# mouse  -> kamera gerekmez, fare imleci bakis gibi davranir (gelistirme)
# webcam -> MediaPipe hatti calisir ([gaze] ekstrasi kurulu olmali)
GAZE_SOURCE=mouse

# Dwell (secim) ayarlari
DWELL_MS=700
DWELL_CANCEL_MS=150
SMOOTHING_WINDOW=5

# Kalibrasyon
CALIBRATION_POINTS=9
CALIBRATION_HOLD_MS=1200
CALIBRATION_DISCARD_MS=300

# Genisletici saglayici: mock | ngram | hf_local | openai_compatible
EXPANDER_PROVIDER=mock
EXPANDER_TOP_K=5
EXPANDER_TIMEOUT_S=2.0

# hf_local icin
HF_MODEL_ID=ytu-ce-cosmos/Turkish-Gemma-9b-v0.1
HF_LOAD_IN_4BIT=true
HF_ADAPTER_PATH=

# openai_compatible icin (anahtari .env dosyasina yazin, repoya koymayin)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Veri yollari (proje kokune gore)
DATA_DIR=../data
