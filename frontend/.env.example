# Backend portu. Windows'ta 8000 rezerve edilmisse (WinError 10013)
# burayi degistirin; uvicorn'u da ayni portla baslatin:
#   uvicorn gaze_aac.main:app --reload --port 8010
BACKEND_PORT=8010

# Arayuzun kendi portu
FRONTEND_PORT=5173

# Dogrudan WebSocket adresi. Bos birakilirsa vite vekili kullanilir
# (onerilen). Yalnizca arayuzu baska bir makinedeki backend'e baglarken
# doldurun, orn: ws://192.168.1.20:8000/ws
VITE_WS_URL=
